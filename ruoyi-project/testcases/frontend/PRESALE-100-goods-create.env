# PRESALE-100-goods-create 配套环境变量（Iron Rule 1：测试数据不硬编码）
# 来源优先级: 本 .env 文件 > 全局环境变量（tests/.env.test）

# --- 被测系统 ---
BASE_URL=http://localhost

# --- 登录凭据 ---
TEST_USER=admin
TEST_PASS=admin123
TEST_DISPLAY_NAME=admin

# --- 业务测试数据（后台新增预售商品）---
# 商品标题（唯一，避免与历史数据混淆）
GOODS_TITLE=E2E后台新增预售商品-模型器
# 定金金额（元）
DEPOSIT_AMOUNT=30
# 尾款金额（元）
TAIL_AMOUNT=70
# 预售截止时间（必须晚于当前时间）
PRESALE_END_TIME=2026-09-30 23:59:59
# 限购数量
LIMIT_QUANTITY=3
# 库存
STOCK=10
