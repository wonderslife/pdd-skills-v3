# ============================================================
# Asset Eval Subcompany Approval L1 - 环境变量配置
# ============================================================
# 对应: asset_eval_subcompany_approval_L1.yaml
# 用途: 资产评估核准 - 子公司内部审批退回流程
#
# 加载优先级（高→低）:
#   1. 本文件 (.env)          ← 用例专属变量，每个测试可不同
#   2. tests/.env.test        ← 框架全局变量（MCP/浏览器/LLM等）
#   3. 内置默认值             ← 代码中的 DEFAULT_CONFIG
#
# 可配置项总览:
#   [登录]     TEST_USER / TEST_PASS / TEST_URL / TEST_DISPLAY_NAME
#   [审批]     APPROVAL_PROJECT_CODE / APPROVAL_REJECT_REASON
#   [执行]     ON_FAIL / MAX_RETRIES / RETRY_DELAY 等（见下方执行配置区）
#   [浏览器]   BROWSER_VIEWPORT_WIDTH / BROWSER_VIEWPORT_HEIGHT
# ============================================================


# ============================================================
# 一、登录配置
# ============================================================
TEST_USER=dongbo
TEST_PASS=dongbo
TEST_DISPLAY_NAME=董博
TEST_URL=http://localhost:8081/login


# ============================================================
# 二、审批流程字段（与 YAML 中 ${变量} 对应）
# ============================================================
# 搜索关键词：项目编号
APPROVAL_PROJECT_CODE=PG-HZ-20260602-904

# 审批退回原因
APPROVAL_REJECT_REASON=退回修改


# ============================================================
# 三、执行配置（覆盖框架内置默认值）
# ============================================================
# 以下变量会覆盖 run_testcase.py 中 DEFAULT_CONFIG 的对应项。
# 未设置时使用内置默认值（括号中为默认值）。
#
# --- 失败策略 ---
# 可选值: stop (遇错即停) | continue (失败继续) | retry (自动重试)
ON_FAIL=stop
#
# --- 重试参数 ---
# MAX_RETRIES=3              # 步骤失败后的最大重试次数 (默认: 3)
# RETRY_DELAY=1.0            # 每次重试的间隔秒数 (默认: 1.0)
#
# --- 等待超时 ---
# DEFAULT_WAIT=2.0           # 默认等待时间(秒)，用于 wait_for 等 (默认: 2.0)
# SNAPSHOT_TIMEOUT=10.0      # 快照获取超时(秒) (默认: 10.0)
# ELEMENT_WAIT_TIMEOUT=5.0   # 元素等待超时(秒) (默认: 5.0)
#
# --- 布尔值开关 (true/false/yes/no/1/0) ---
# CONTINUE_ON_ERROR=false    # 失败后是否继续执行后续步骤 (默认: false)
# SCREENSHOT_ON_ERROR=true   # 失败时是否自动截图 (默认: true)
# VERBOSE_LOGGING=true       # 是否输出详细日志 (默认: true)
# LLM_THINK_ENABLED=false    # 启用 LLM 思维链辅助决策 (默认: false)
# LLM_THINK_DEEP=false       # 深度思维模式 (默认: false)


# ============================================================
# 四、浏览器配置（覆盖 tests/.env.test 中的值）
# ============================================================
BROWSER_VIEWPORT_WIDTH=1400
BROWSER_VIEWPORT_HEIGHT=800
